{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ahadex-tools",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "ahadex.online/*",
      "custom_domain": true
    },
    {
      "pattern": "www.ahadex.online/*",
      "custom_domain": true
    }
  ]
}
